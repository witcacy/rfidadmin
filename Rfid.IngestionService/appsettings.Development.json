{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },

    "TcpIngestion": {
        "Enabled": true,
        "ListenIp": "0.0.0.0",
        "Port": 9000,
        "BufferSize": 4096,
        "MaxClients": 50,
        "MessageDelimiter": "\n"
    },

    "Llrp": {
        "Enabled": false,
        "DefaultPort": 5084,
        "Readers": [
            {
                "ReaderId": "FX9600_01",
                "Ip": "192.168.1.10",
                "Port": 5084,
                "Zone": "PUERTA_A"
            }
        ]
    },

    "SignalR": {
        "Enabled": true,
        "HubUrl": "http://localhost:5000/rfidHub",
        "Reconnect": {
            "Enabled": true,
            "RetryDelaysSeconds": [ 2, 5, 10, 30 ]
        }
    },

    "Mqtt": {
        "Enabled": true,
        "Broker": {
            "Host": "localhost",
            "Port": 1883,
            "ClientId": "rfid-ingestion-service",
            "UseTls": false
        },
        "Topics": {
            "TagDetected": "rfid/events/tagDetected",
            "ReaderStatus": "rfid/events/readerStatus"
        }
    },

    "EventProcessing": {
        "DeduplicationWindowMs": 1500
    },

    "ConnectionStrings": {
        "SqlServer": "Server=localhost;Database=RfidDb;User Id=rfid_user;Password=rfid_password;"
    }
}